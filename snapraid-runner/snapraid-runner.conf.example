[snapraid]
# Use absolute paths. The runner does not resolve executables through PATH.
# The installed binary must report exactly SnapRAID v11.3.
executable = /usr/local/bin/snapraid
config = /etc/snapraid.conf

[safety]
# Every invocation takes this non-blocking POSIX flock for its entire lifetime.
lock_file = /run/lock/homeserver-snapraid.lock

# Content files must be byte-identical and reside on at least this many distinct,
# genuine local block-backed filesystems before a read-only diff is allowed.
minimum_content_copies = 2

# The systemd unit bounds the whole report at six hours and first sends SIGINT.
# Keep the internal read-only diff timeout below that whole-service bound.
diff_timeout_seconds = 18000

# Fixed recovery identity. The runner rejects changes to any of these values.
d3_name = d3
d3_mount = /media/storagedrive3
d3_filesystem_uuid = ad352d2c-6f7c-4c5e-99f1-3d4e6d03c8a8
d3_luks_uuid = af36e2aa-c2be-4eef-9f3b-ae79cc64445f
d3_mapper = /dev/mapper/storagedrive3
d3_backing_by_uuid = /dev/disk/by-uuid/af36e2aa-c2be-4eef-9f3b-ae79cc64445f

# Verified partition-level identity. The runner requires it to resolve to the
# same backing block device as d3_backing_by_uuid.
d3_backing_by_id = /dev/disk/by-id/ata-OOS14000G_000D87HC-part1
